#!/usr/bin/env bash
# Rendered by Terraform and executed inside the Ollama LXC.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl ca-certificates python3 python3-venv python3-pip

# --- Install Ollama -------------------------------------------------------
if ! command -v ollama >/dev/null 2>&1; then
  curl -fsSL https://ollama.com/install.sh | sh
fi

# --- CPU tuning (see the sizing discussion) -------------------------------
# KEEP_ALIVE high so the model isn't evicted/reloaded between the harness's
# many short calls (a CPU reload would dominate grid time). One request at a
# time on 4 threads. Listen on all interfaces so the harness can run here or
# be pointed at this container with --host.
mkdir -p /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/override.conf <<EOF
[Service]
Environment="OLLAMA_KEEP_ALIVE=24h"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_NUM_THREADS=${cores}"
Environment="OLLAMA_HOST=0.0.0.0"
EOF

systemctl daemon-reload
systemctl enable --now ollama
systemctl restart ollama

# wait for the API to come up
for i in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
    break
  fi
  sleep 2
done

# --- Pull models ----------------------------------------------------------
%{ for m in models ~}
echo "[+] pulling ${m}"
ollama pull "${m}"
%{ endfor ~}

echo "[+] Ollama ready. Models:"
ollama list
